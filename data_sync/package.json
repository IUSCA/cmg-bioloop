{
  "name": "cmg-bioloop-data-sync",
  "version": "1.0.0",
  "description": "CMG to Bioloop database synchronization scripts",
  "main": "src/bigbang_cmg_sync.js",
  "scripts": {
    "bigbang": "node src/bigbang_cmg_sync.js",
    "poller": "node src/poller_sync.js",
    "prisma:generate": "prisma generate --schema=/opt/sca/api/prisma/schema.prisma",
    "prisma:generate:xenium": "prisma generate --schema=prisma/xenium_source.prisma",
    "prisma:generate:all": "npm run prisma:generate && npm run prisma:generate:xenium",
    "prisma:migrate": "prisma migrate deploy --schema=/opt/sca/api/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=/opt/sca/api/prisma/schema.prisma"
  },
  "keywords": [
    "cmg",
    "bioloop",
    "migration",
    "sync"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "5.20.0",
    "config": "^3.3.9",
    "dotenv": "^16.3.1",
    "module-alias": "^2.2.3",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "mongodb": "^7.1.0",
    "prisma": "5.20.0"
  },
  "prisma": {
    "schema": "/opt/sca/api/prisma/schema.prisma"
  },
  "_moduleAliases": {
    "@": "src"
  }
}
