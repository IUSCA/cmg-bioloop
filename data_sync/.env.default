# Node Environment
NODE_ENV=development

# Database Sync Environment Variables

# Local PostgreSQL (inside db_sandbox container)
SYNC_PG_HOST=localhost
SYNC_PG_PORT=5432
SYNC_PG_USER=appuser
SYNC_PG_PASSWORD=example
SYNC_PG_DATABASE=bioloop_sync
DATABASE_URL=postgresql://appuser:example@localhost:5432/bioloop_sync?schema=public

# CMG MongoDB (source data)
CMG_MONGO_HOST=commons3.sca.iu.edu
CMG_MONGO_PORT=27017
CMG_MONGO_DB=cmg
CMG_MONGO_USERNAME=
CMG_MONGO_PASSWORD=

# CMG Legacy Conversion Logs Directory (for historic conversion logs population)
# This directory contains convert_{dataset_name}.log files from CMG production
CMG_LEGACY_CONVERSIONS_LOGS_DIR=/N/project/CMG-SCA/runlogs

# Data root directory (for error logs and temporary files)
DATA_ROOT=/tmp
