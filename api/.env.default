# in test and production deployments set NODE_ENV accordingly
NODE_ENV=docker

POSTGRES_HOST=postgres
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=${POSTGRES_SCHEMA}"

WORKFLOW_SERVER_BASE_URL=http://rhythm:5001
WORKFLOW_AUTH_TOKEN=xxx


OAUTH_BASE_URL=http://signet:5050

# If using local dev setup do not change the following oauth values
OAUTH_DOWNLOAD_CLIENT_ID=xxx
OAUTH_DOWNLOAD_CLIENT_SECRET=xxx
OAUTH_UPLOAD_CLIENT_ID=xxx
OAUTH_UPLOAD_CLIENT_SECRET=xxx
OAUTH_GENOME_BROWSER_CLIENT_ID=xxx
OAUTH_GENOME_BROWSER_CLIENT_SECRET=xxx

GOOGLE_OAUTH_CLIENT_ID=example
GOOGLE_OAUTH_CLIENT_SECRET=example

CILOGON_OAUTH_CLIENT_ID=example
CILOGON_OAUTH_CLIENT_SECRET=example

MICROSOFT_OAUTH_CLIENT_ID=example
MICROSOFT_OAUTH_CLIENT_SECRET=example

DOWNLOAD_SERVER_BASE_URL=http://localhost:3060

FILESYSTEM_SEARCH_SPACES=/opt/sca/data/imports
FILESYSTEM_BASE_DIR_SCRATCH=/opt/sca/data/imports
FILESYSTEM_MOUNT_DIR_SCRATCH=/opt/sca/data/imports
FILESYSTEM_BASE_DIR_PROJECT=/opt/sca/data/project
FILESYSTEM_MOUNT_DIR_PROJECT=/opt/sca/data/project
# FILESYSTEM_BASE_DIR_PROJECT_1=/opt/sca/data/project_1
# FILESYSTEM_MOUNT_DIR_PROJECT_1=/opt/sca/data/project_1
SCRATCH_IMPORT_RESTRICTED_DIRS=/opt/sca/data/imports
# SCRATCH_IMPORT_RESTRICTED_DIRS=/pattern/to/match/multiple/restricted/dirs/**/*,path/to/single/restricted/dir

UPLOAD_HOST_DIR=/opt/sca/data/uploads
CONVERSION_OUTPUT_DIR=/opt/sca/data/conversions

DATA_ROOT=/opt/sca/data/staged

# CMG_MONGO_HOST=commons3...
# CMG_MONGO_PORT=27017
# CMG_MONGO_DB=test
# CMG_MONGO_AUTH_SOURCE=admin
# CMG_MONGO_USERNAME=test
# CMG_MONGO_PASSWORD=test

TEMP_AGENT_ACCESS=xyz
