{
  "mode": "default",
  "app_id": "cmg-test.sca.iu.edu",
  "default_queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q",
  "fetch_queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q",
  "archive_queue": "cmg-bioloop-archive.cmg-test.sca.iu.edu.q",
  "conversion_queue": "cmg-bioloop-conversion.cmg-test.sca.iu.edu.q",
  "express": {
    "port": 3030,
    "host": "localhost"
  },
  "logger": {
    "level": "debug"
  },
  "data_root": "/opt/sca/data",
  "workflow_server": {
    "base_url": "http://rhythm:5001",
    "auth_token": ""
  },
  "cmg_mongodb": {
    "host": "localhost",
    "port": 27017,
    "database": "cmg",
    "username": "",
    "password": ""
  },
  "rhythm_mongodb": {
    "host": "localhost",
    "port": 27018,
    "database": "rhythm",
    "username": "",
    "password": ""
  },
  "auth": {
    "mode": "dev",
    "jwt": {
      "iss": "localhost",
      "ttl_milliseconds": 604800000,
      "pub": "keys/auth.pub",
      "key": "keys/auth.key",
      "sign_algorithm": "RS256"
    },
    "google": {
      "enabled": true,
      "authorization_endpoint": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_endpoint": "https://oauth2.googleapis.com/token",
      "scope": "openid email",
      "client_id": "",
      "client_secret": ""
    },
    "cilogon": {
      "enabled": true,
      "authorization_endpoint": "https://cilogon.org/authorize",
      "token_endpoint": "https://cilogon.org/oauth2/token",
      "scope": "openid+email",
      "client_id": "",
      "client_secret": ""
    },
    "microsoft": {
      "enabled": true,
      "authorization_endpoint": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "token_endpoint": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "scope": "https://graph.microsoft.com/User.Read",
      "client_id": "",
      "client_secret": ""
    },
    "auto_sign_up": {
      "enabled": false,
      "default_role": "user"
    },
    "signup": {
      "default_role": "user",
      "dev_default_role": "admin",
      "jwt": {
        "scope": "signup",
        "ttl_milliseconds": 600000
      },
      "auto_generate_username_if_not_unique": true,
      "max_username_suffix": 999
    }
  },
  "oauth": {
    "base_url": "",
    "download": {
      "client_id": "",
      "client_secret": "",
      "scope_prefix": "download_file:"
    },
    "genome_browser": {
      "client_id": "",
      "client_secret": "",
      "scope_prefix": "genome_browser_file:"
    }
  },
  "secure_download": {
    "base_url": "http://localhost:3060",
    "genome_browser_path_prefix": "/files/expose"
  },
  "upload": {
    "path": ""
  },
  "conversion": {
    "output_dir": "/opt/sca/data/conversions"
  },
  "trackFileTypes": [
    { "name": "BAM", "id": "bam" },
    { "name": "BigWig", "id": "bigwig" },
    { "name": "VCF", "id": "vcf" },
    { "name": "FASTQ", "id": "fastq" }
  ],
  "fileExtensionMapping": {
    ".bam": "BAM",
    ".bam.bai": "BAI",
    ".bai": "BAI",
    ".vcf.gz": "VCF_GZ",
    ".vcf.gz.tbi": "TBI",
    ".tbi": "TBI",
    ".bw": "BIGWIG",
    ".bigwig": "BIGWIG",
    ".bed": "BED",
    ".fastq.gz": "FASTQ_GZ",
    ".fq.gz": "FASTQ_GZ",
    ".html": "HTML_REPORT",
    ".txt": "TEXT"
  },
  "download_server": {
    "base_url": ""
  },
  "workflow_registry": {
    "integrated": {
      "description": "An end-to-end workflow to inspect, archive, stage and validate a dataset. Includes optional Xenium-specific steps (parse_analysis_data, upload_static_content) that are no-ops for non-Xenium datasets.",
      "steps": [
        {
          "name": "await stability",
          "task": "await_stability",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "inspect",
          "task": "inspect_dataset",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "parse analysis data",
          "task": "parse_analysis_data",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q",
          "comment": "Xenium-specific: reads analysis_summary.html from origin_path. No-op for non-Xenium datasets."
        },
        {
          "name": "run qc",
          "task": "generate_qc",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "archive",
          "task": "archive_dataset",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "stage",
          "task": "stage_dataset",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "validate",
          "task": "validate_dataset",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "setup_download",
          "task": "setup_dataset_download",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "upload static content",
          "task": "upload_static_content",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q",
          "comment": "Xenium-specific: uploads analysis_summary.html from staged_path. No-op for non-Xenium datasets."
        }
      ]
    },
    "intake_integrated": {
      "description": "End-to-end workflow for datasets on archive node (watch.py instrument ingestion). Includes optional Xenium-specific steps (parse_analysis_data, upload_static_content) that are no-ops for non-Xenium datasets.",
      "steps": [
        {
          "name": "await stability",
          "task": "await_stability",
          "queue": "cmg-bioloop-archive.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "inspect",
          "task": "inspect_dataset",
          "queue": "cmg-bioloop-archive.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "parse analysis data",
          "task": "parse_analysis_data",
          "queue": "cmg-bioloop-archive.cmg-test.sca.iu.edu.q",
          "comment": "Xenium-specific: reads analysis_summary.html from origin_path before archival. No-op for non-Xenium datasets."
        },
        {
          "name": "archive",
          "task": "archive_dataset",
          "queue": "cmg-bioloop-archive.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "stage",
          "task": "stage_dataset",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "validate",
          "task": "validate_dataset",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "setup_download",
          "task": "setup_dataset_download",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "upload static content",
          "task": "upload_static_content",
          "queue": "cmg-bioloop-fetch.cmg-test.sca.iu.edu.q",
          "comment": "Xenium-specific: uploads analysis_summary.html from staged_path. No-op for non-Xenium datasets."
        }
      ]
    },
    "subdir_wf_initiator": {
      "description": "Workflow for Xenium RAW_DATA datasets: awaits stability, then registers each subdirectory as a DATA_PRODUCT and launches the intake_integrated workflow on each.",
      "steps": [
        {
          "name": "await stability",
          "task": "await_stability",
          "queue": "cmg-bioloop-xenium-archive.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "initiate dataproduct workflows",
          "task": "initiate_subdir_workflows",
          "queue": "cmg-bioloop-xenium-archive.cmg-test.sca.iu.edu.q"
        }
      ]
    },
    "stage_migrated_xenium": {
      "description": "Stage and validate Xenium datasets that were migrated via bigbang. Unlike stage_migrated (CMG), no archive retrieval is needed — files are accessible on the Xenium file system.",
      "steps": [
        {
          "name": "begin_migration",
          "task": "begin_migration",
          "queue": "cmg-bioloop-xenium-archive.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "inspect",
          "task": "inspect_dataset",
          "queue": "cmg-bioloop-xenium-archive.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "parse analysis data",
          "task": "parse_analysis_data",
          "queue": "cmg-bioloop-xenium-archive.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "stage",
          "task": "stage_dataset",
          "queue": "cmg-bioloop-xenium-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "validate",
          "task": "validate_dataset",
          "queue": "cmg-bioloop-xenium-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "setup_download",
          "task": "setup_dataset_download",
          "queue": "cmg-bioloop-xenium-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "upload static content",
          "task": "upload_static_content",
          "queue": "cmg-bioloop-xenium-fetch.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "end_migration",
          "task": "end_migration",
          "queue": "cmg-bioloop-xenium-fetch.cmg-test.sca.iu.edu.q"
        }
      ]
    },
    "stage": {
      "steps": [
        {
          "name": "stage",
          "task": "stage_dataset"
        },
        {
          "name": "validate",
          "task": "validate_dataset"
        },
        {
          "name": "setup_download",
          "task": "setup_dataset_download"
        }
      ]
    },
    "stage_migrated": {
      "description": "Stage and hydrate legacy CMG datasets with file and track metadata",
      "steps": [
        {
          "name": "begin_migration",
          "task": "begin_migration"
        },
        {
          "name": "retrieve_archive",
          "task": "retrieve_archive_dataset"
        },
        {
          "name": "inspect",
          "task": "inspect_dataset"
        },
        {
          "name": "populate_metadata",
          "task": "populate_metadata_dataset"
        },
        {
          "name": "stage",
          "task": "stage_dataset"
        },
        {
          "name": "validate",
          "task": "validate_dataset"
        },
        {
          "name": "setup_download",
          "task": "setup_dataset_download"
        },
        {
          "name": "end_migration",
          "task": "end_migration"
        }
      ]
    },
    "delete": {
      "steps": [
        {
          "name": "delete",
          "task": "delete_dataset"
        }
      ]
    },
    "conversion": {
      "name": "Conversion",
      "steps": [
        {
          "name": "convert",
          "task": "convert_dataset",
          "queue": "cmg-bioloop-conversion.cmg-test.sca.iu.edu.q"
        }
      ]
    },
    "genomic_conversion": {
      "name": "Genomic Conversion",
      "steps": [
        {
          "name": "convert",
          "task": "convert_genomic",
          "queue": "cmg-bioloop-conversion.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "copy reports",
          "task": "copy_conversion_reports",
          "queue": "cmg-bioloop-conversion.cmg-test.sca.iu.edu.q"
        },
        {
          "name": "derive data products",
          "task": "derive_data_products",
          "queue": "cmg-bioloop-conversion.cmg-test.sca.iu.edu.q"
        }
      ]
    },
    "file_info_population": {
      "name": "File Info Population",
      "steps": [
        {
          "name": "populate file metadata",
          "task": "populate_file_metadata"
        }
      ]
    },
    "hydrate_session": {
      "name": "Hydrate Session",
      "description": "Hydrate legacy CMG Session with Tracks",
      "steps": [
        {
          "name": "hydrate_tracks",
          "task": "hydrate_session_tracks"
        },
        {
          "name": "finish_hydration",
          "task": "finish_session_hydration"
        }
      ]
    }
  },
  "dataset_types": [
    "RAW_DATA",
    "DATA_PRODUCT"
  ],
