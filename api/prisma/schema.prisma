generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model dataset {
  id                       Int                          @id @default(autoincrement())
  name                     String
  type                     String
  num_directories          Int?
  num_files                Int?
  du_size                  BigInt?
  size                     BigInt?
  bundle_size              BigInt?
  description              String?
  created_at               DateTime                     @default(now()) @db.Timestamp(6)
  updated_at               DateTime                     @default(now()) @updatedAt @db.Timestamp(6)
  origin_path              String?
  archive_path             String?
  staged_path              String?
  is_deleted               Boolean                      @default(false)
  is_staged                Boolean                      @default(false)
  metadata                 Json?
  src_instrument_id        Int?
  file_type                String?
  workflows                workflow[]
  files                    dataset_file[]
  audit_logs               dataset_audit[]
  states                   dataset_state[]
  derived_datasets         dataset_hierarchy[]          @relation("source_datasets")
  source_datasets          dataset_hierarchy[]          @relation("derived_datasets")
  projects                 project_dataset[]
  accesses                 data_access_log[]
  stage_requests           stage_request_log[]
  bundle                   bundle?
  src_instrument           instrument?                  @relation(fields: [src_instrument_id], references: [id])
  conversions              conversion[]
  derived_from_conversions conversion_derived_dataset[]
  genomic_details          dataset_genomic_attributes?
  cmg_id                   String?

  @@unique([name, type, is_deleted])
}

model dataset_genomic_attributes {
  dataset_id   Int     @id
  dataset      dataset @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  genome_type  String?
  genome_value String?
}

model dataset_hierarchy {
  source_id       Int
  derived_id      Int
  assigned_at     DateTime @default(now()) @db.Timestamp(6)
  source_dataset  dataset  @relation(name: "source_datasets", fields: [source_id], references: [id], onDelete: Cascade)
  derived_dataset dataset  @relation(name: "derived_datasets", fields: [derived_id], references: [id], onDelete: Cascade)

  @@id([source_id, derived_id])
}

model dataset_file {
  id         Int                      @id @default(autoincrement())
  name       String?
  path       String
  md5        String?
  size       BigInt?
  filetype   String?
  metadata   Json?
  status     String?
  dataset_id Int
  dataset    dataset                  @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  parents    dataset_file_hierarchy[] @relation("child")
  children   dataset_file_hierarchy[] @relation("parent")
  accesses   data_access_log[]
  track      track?

  @@unique([path, dataset_id])
  @@index([dataset_id])
}

model dataset_file_hierarchy {
  parent_id Int
  child_id  Int
  parent    dataset_file? @relation(name: "parent", fields: [parent_id], references: [id], onDelete: Cascade)
  child     dataset_file? @relation(name: "child", fields: [child_id], references: [id], onDelete: Cascade)

  @@id([parent_id, child_id])
  @@index([child_id])
}

model dataset_upload_log {
  id           Int               @id @default(autoincrement())
  status       upload_status
  files        file_upload_log[]
  updated_at   DateTime          @default(now()) @updatedAt @db.Timestamp(6)
  audit_log    dataset_audit     @relation(fields: [audit_log_id], references: [id], onDelete: Cascade)
  audit_log_id Int               @unique
}

model file_upload_log {
  id                    Int                 @id @default(autoincrement())
  name                  String
  md5                   String
  num_chunks            Int
  status                upload_status
  path                  String?
  dataset_upload_log    dataset_upload_log? @relation(fields: [dataset_upload_log_id], references: [id], onDelete: Cascade)
  dataset_upload_log_id Int?
}

model dataset_import_log {
  id           Int           @id @default(autoincrement())
  created_at   DateTime      @default(now()) @db.Timestamp(6)
  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamp(6)
  cmg_id       String?       @db.VarChar(100)
  file_type    String?
  genome_type  String?
  genome_value String?
  source_run   String?
  notes        String?
  metadata     Json?
  audit_log    dataset_audit @relation(fields: [audit_log_id], references: [id], onDelete: Cascade)
  audit_log_id Int           @unique
}

model dataset_audit {
  id            Int                    @id @default(autoincrement())
  action        String
  create_method DATASET_CREATE_METHOD?
  updated_at    DateTime               @default(now()) @updatedAt @db.Timestamp(6)
  timestamp     DateTime               @default(now())
  old_data      Json?
  new_data      Json?
  user_id       Int?
  user          user?                  @relation(fields: [user_id], references: [id], onDelete: SetNull)
  dataset_id    Int?
  dataset       dataset?               @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  upload        dataset_upload_log?
  import        dataset_import_log?

  @@unique([dataset_id, create_method])
}

model dataset_state {
  state      String
  timestamp  DateTime @default(now()) @db.Timestamp(6)
  metadata   Json?
  dataset_id Int
  dataset    dataset? @relation(fields: [dataset_id], references: [id], onDelete: Cascade)

  @@id([timestamp, dataset_id, state])
}

model bundle {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamp(6)
  name       String
  size       BigInt?
  md5        String
  dataset_id Int      @unique
  dataset    dataset  @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
}

model data_access_log {
  id           Int           @id @default(autoincrement())
  timestamp    DateTime      @default(now()) @db.Timestamp(6)
  access_type  access_type
  file_id      Int?
  dataset_file dataset_file? @relation(fields: [file_id], references: [id])
  dataset_id   Int?
  dataset      dataset?      @relation(fields: [dataset_id], references: [id])
  user_id      Int?
  user         user?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model stage_request_log {
  id         Int      @id @default(autoincrement())
  timestamp  DateTime @default(now()) @db.Timestamp(6)
  dataset_id Int?
  dataset    dataset? @relation(fields: [dataset_id], references: [id])
  user_id    Int?
  user       user?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model user {
  id                         Int                      @id @default(autoincrement())
  username                   String                   @unique @db.VarChar(100)
  name                       String?                  @db.VarChar(100)
  email                      String                   @unique @db.VarChar(100)
  cas_id                     String?                  @unique @db.VarChar(100)
  notes                      String?
  created_at                 DateTime                 @default(now()) @db.Timestamp(6)
  updated_at                 DateTime                 @default(now()) @updatedAt @db.Timestamp(6)
  is_deleted                 Boolean                  @default(false)
  metadata                   Json?
  cmg_id                     String?                  @db.VarChar(100)
  user_role                  user_role[]
  settings                   user_settings?
  contacts                   contact[]
  dataset_audit              dataset_audit[]
  projects                   project_user[]           @relation("project_user_user")
  password                   user_password?
  login                      user_login?
  accesses                   data_access_log[]
  stage_requests             stage_request_log[]
  about_edits                about[]
  project_users_assigned     project_user[]           @relation("project_user_assignor")
  project_datasets_assigned  project_dataset[]
  project_contacts_assigned  project_contact[]
  initiated_workflows         workflow[]          @relation("initiated_workflows")
  initiated_session_workflows session_workflow[]  @relation("initiated_session_workflows")
  acknowledged_notifications  notification[]
  user_notifications          user_notification[]
  genome_browser_sessions     genome_browser_session[]
  conversion_definitions      conversion_definition[]
  conversions                 conversion[]
  // created_datasets           dataset_create_log[]
}

model user_password {
  id         Int      @id @default(autoincrement())
  password   String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
  user_id    Int      @unique
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_login {
  id         Int      @id @default(autoincrement())
  last_login DateTime @default(now()) @db.Timestamp(6)
  method     String
  user_id    Int      @unique
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model user_settings {
  id       Int  @id @default(autoincrement())
  user_id  Int  @unique
  settings Json
  users    user @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model notification {
  id                 Int                 @id @default(autoincrement())
  created_at         DateTime            @default(now()) @db.Timestamp(6)
  label              String
  text               String?
  status             NOTIFICATION_STATUS @default(CREATED)
  acknowledged_by_id Int?
  acknowledged_by    user?               @relation(fields: [acknowledged_by_id], references: [id], onDelete: Cascade)
  role_notifications role_notification[]
  user_notifications user_notification[]
}

model role_notification {
  id              Int          @id @default(autoincrement())
  role_id         Int
  role            role         @relation(fields: [role_id], references: [id])
  notification_id Int
  notification    notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, role_id])
}

model user_notification {
  id              Int          @id @default(autoincrement())
  user_id         Int
  user            user         @relation(fields: [user_id], references: [id])
  notification_id Int
  notification    notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, user_id])
}

model contact {
  id          Int               @id @default(autoincrement())
  type        String
  value       String
  description String?
  user_id     Int?
  user        user?             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  projects    project_contact[]

  @@unique([type, value])
}

model role {
  id                 Int                 @id @default(autoincrement())
  name               String              @db.VarChar(50)
  description        String              @default("") @db.VarChar(255)
  user_role          user_role[]
  role_notifications role_notification[]
}

model user_role {
  user_id     Int
  role_id     Int
  roles       role     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  users       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  assigned_at DateTime @default(now())

  @@id([user_id, role_id])
}

model workflow {
  id           String   @id
  dataset_id   Int?
  dataset      dataset? @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  initiator_id Int?
  initiator    user?    @relation("initiated_workflows", fields: [initiator_id], references: [id], onDelete: SetNull)
  worker_processes worker_process[]
}

model metric {
  timestamp   DateTime @default(now()) @db.Timestamp(6)
  measurement String
  subject     String
  usage       BigInt?
  limit       BigInt?
  fields      Json?
  tags        Json?

  @@id([timestamp, measurement, subject])
}

model project {
  id              String            @id @default(uuid())
  slug            String            @unique
  name            String
  description     String?
  browser_enabled Boolean           @default(false)
  funding         String?
  metadata        Json?
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @updatedAt @db.Timestamp(6)
  cmg_id          String?
  users           project_user[]
  datasets        project_dataset[]
  contacts        project_contact[]
}

model project_user {
  project_id  String
  user_id     Int
  assigned_at DateTime @default(now()) @db.Timestamp(6)
  assignor_id Int?
  project     project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  user        user     @relation(fields: [user_id], references: [id], onDelete: Cascade, name: "project_user_user")
  assignor    user?    @relation(fields: [assignor_id], references: [id], onDelete: SetNull, name: "project_user_assignor")

  @@id([project_id, user_id])
}

model project_dataset {
  project_id  String
  dataset_id  Int
  assignor_id Int?
  assigned_at DateTime @default(now()) @db.Timestamp(6)
  project     project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  dataset     dataset  @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  assignor    user?    @relation(fields: [assignor_id], references: [id], onDelete: SetNull)

  @@id([project_id, dataset_id])
}

model project_contact {
  project_id  String
  contact_id  Int
  assigned_at DateTime @default(now()) @db.Timestamp(6)
  assignor_id Int?
  project     project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  contact     contact  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  assignor    user?    @relation(fields: [assignor_id], references: [id], onDelete: SetNull)

  @@id([project_id, contact_id])
}

model log {
  id                Int            @id @default(autoincrement())
  timestamp         DateTime       @default(now()) @db.Timestamp(6)
  message           String
  level             String
  worker_process_id Int
  worker_log        worker_process @relation(fields: [worker_process_id], references: [id], onDelete: Cascade)

  @@index([worker_process_id])
}

model worker_process {
  id          Int      @id @default(autoincrement())
  pid         Int
  task_id     String
  executor_job_id String? // ID of external process started by job (for jobs running on external platforms like Slurm/k8s)
  step        String
  workflow_id String?
  workflow    workflow? @relation(fields: [workflow_id], references: [id])
  tags        Json?
  start_time  DateTime @default(now()) @db.Timestamp(6)
  hostname    String
  logs        log[]
}

model process_artifact {
  id                  Int               @id @default(autoincrement())
  process_id        Int
  process            process_request @relation(fields: [process_id], references: [id], onDelete: Cascade)
  artifact_type       artifact_type
  storage_type        storage_type @default(INLINE)
  content_inline      String?           // small files can be stored directly
  file_path           String?
  external_url        String?           // external storage (S3 etc.)
  supports_template   Boolean @default(false)
  template_variables  Json?             // variables/config used to render in UI
  created_at          DateTime @default(now()) @db.Timestamp(6)
  updated_at          DateTime @updatedAt @db.Timestamp(6)
}

model about {
  id                 Int      @id @default(autoincrement())
  html               String
  created_at         DateTime @default(now()) @db.Timestamp(6)
  last_updated_by    user?    @relation(fields: [last_updated_by_id], references: [id], onDelete: SetNull)
  last_updated_by_id Int?
}

model nonce {
  id         String    @id @default(uuid())
  created_at DateTime  @default(now()) @db.Timestamp(6)
  purpose    String?
  expires_at DateTime?
}

model instrument {
  id               Int       @id @default(autoincrement())
  name             String    @unique
  host             String    @unique
  description      String?
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @db.Timestamp(6)
  sourced_datasets dataset[]
}

model track {
  id              Int             @id @default(autoincrement())
  name            String
  dataset_file_id Int             @unique
  dataset_file    dataset_file    @relation(fields: [dataset_file_id], references: [id], onDelete: Cascade)
  color           String?
  created_at      DateTime        @default(now()) @db.Timestamp(6)
  updated_at      DateTime        @default(now()) @updatedAt @db.Timestamp(6)
  session_tracks  session_track[]
}

model genome_browser_session {
  id                Int                @id @default(autoincrement())
  title             String?
  genome            String?
  genome_type       String?
  user_id           Int?
  user              user?              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at        DateTime           @default(now()) @db.Timestamp(6)
  updated_at        DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  access_count      Int                @default(0)
  is_public         Boolean            @default(false)
  metadata          Json?
  cmg_id            String?            @db.VarChar(100) // CMG session ID for migration tracking
  session_tracks    session_track[]
  session_workflows session_workflow[]
}

model session_track {
  id         Int                    @id @default(autoincrement())
  session_id Int
  track_id   Int
  color      String?
  title      String?
  order      Int                    @default(0)
  session    genome_browser_session @relation(fields: [session_id], references: [id], onDelete: Cascade)
  track      track                  @relation(fields: [track_id], references: [id], onDelete: Cascade)
  created_at DateTime               @default(now()) @db.Timestamp(6)
  updated_at DateTime               @default(now()) @updatedAt @db.Timestamp(6)

  @@unique([session_id, track_id])
}

model session_workflow {
  session_id   Int
  workflow_id  String
  session      genome_browser_session @relation(fields: [session_id], references: [id], onDelete: Cascade)
  initiator_id Int?
  initiator    user?                  @relation("initiated_session_workflows", fields: [initiator_id], references: [id], onDelete: SetNull)
  created_at   DateTime               @default(now()) @db.Timestamp(6)

  @@id([session_id, workflow_id])
}

model conversion_definition {
  id               Int              @id @default(autoincrement())
  created_at       DateTime         @default(now()) @db.Timestamp(6)
  updated_at       DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  name             String           @unique
  description      String?
  enabled          Boolean          @default(false)
  author_id        Int
  dataset_types    String[] // can run on only these datatypes
  tags             String[] // tags for searching
  program_id       Int
  output_directory String?
  logs_directory   String?
  capture_logs     Boolean          @default(false)
  program          cmd_line_program @relation(fields: [program_id], references: [id])
  author           user             @relation(fields: [author_id], references: [id])
  conversions      conversion[]
}

model cmd_line_program {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @unique
  executable_path       String
  executable_directory  String?
  arguments             argument[]
  allow_additional_args Boolean                 @default(false) // Whether additional arguments are allowed
  created_at            DateTime                @default(now()) @db.Timestamp(6)
  updated_at            DateTime                @default(now()) @updatedAt @db.Timestamp(6)
  conversion_definition conversion_definition[]
  // additional_args_rules Json?   // e.g., {"allowed_flags": ["--no-lane-splitting", "--force"], "forbidden_patterns": ["--output-dir"]}

  @@unique([name, executable_path])
}

model argument {
  id                    Int                 @id @default(autoincrement())
  name                  String? // Name of the argument (e.g., "--verbose")
  value_type            argument_value_type // Type of value the argument can have
  allowed_values        String[] // Optional list of allowed values (e.g., ["fast", "safe"])
  is_required           Boolean             @default(false) // Whether the argument is required or optional
  default_value         String? // Default value for the argument
  is_flag               Boolean             @default(false) // Whether the argument is a flag (boolean) without a value
  description           String? // Optional description of the argument
  min_value             Float? // Optional minimum value (for numeric types)
  max_value             Float? // Optional maximum value (for numeric types)
  min_length            Int? // Optional minimum length (for string types)
  max_length            Int? // Optional maximum length (for string types)
  position              Int? // Position index for positional arguments, null for named arguments
  dynamic_variable_name String? // Name of the dynamic variable (if any)
  dynamic_variable      dynamic_variable?   @relation(fields: [dynamic_variable_name], references: [name])
  program_id            Int // Foreign key to cmd_line_program
  program               cmd_line_program    @relation(fields: [program_id], references: [id])
  argument_values       argument_value[]
}

model argument_value {
  id            Int        @id @default(autoincrement())
  argument_id   Int // Foreign key to Argument
  conversion_id Int // Foreign key to Execution
  value         String?
  argument      argument   @relation(fields: [argument_id], references: [id])
  conversion    conversion @relation(fields: [conversion_id], references: [id])
}

model process_request {
  id              Int                   @id @default(autoincrement())
  execution_platform execution_platform @default(LOCAL)
  job_step          String? // e.g. "checksum-computation", "file-download"
  conversion_id           Int?
  conversion              conversion? @relation(fields: [conversion_id], references: [id], onDelete: SetNull)
  artifacts       process_artifact[]
  execution_config    Json?              // Execution-specific config
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @updatedAt @db.Timestamp(6)
}

model conversion {
  id               Int                          @id @default(autoincrement())
  cmg_id           String?
  initiated_at     DateTime                     @default(now()) @db.Timestamp(6)
  definition_id    Int
  workflow_id      String?
  dataset_id       Int?
  initiator_id     Int?
  argument_values  argument_value[]
  dataset          dataset?                     @relation(fields: [dataset_id], references: [id], onDelete: Cascade)
  definition       conversion_definition        @relation(fields: [definition_id], references: [id])
  initiator        user?                        @relation(fields: [initiator_id], references: [id], onDelete: SetNull)
  additional_args  Json? // e.g., { [ {"--no-lane-splitting": "true" }, {"--barcode-mismatches": "1"} ] }
  derived_datasets conversion_derived_dataset[]
  requested_processes process_request[]
  metadata Json?
}

model conversion_derived_dataset {
  conversion_id Int
  dataset_id    Int
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  updated_at    DateTime   @default(now()) @updatedAt @db.Timestamp(6)
  metadata      Json? // Additional metadata about the derived dataset process
  conversion    conversion @relation(fields: [conversion_id], references: [id], onDelete: Cascade)
  dataset       dataset    @relation(fields: [dataset_id], references: [id], onDelete: Cascade)

  @@id([conversion_id, dataset_id])
}

model dynamic_variable {
  name        String     @id
  description String?
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @default(now()) @updatedAt @db.Timestamp(6)
  argument    argument[]
}

enum execution_platform {
  LOCAL            // app host
  // PBS          // PBS/Torque
  SLURM          // SLURM cluster
  KUBERNETES     // K8s Job
  AWS_BATCH      // AWS Batch
  CUSTOM         // User-defined
}

enum artifact_type {
  JOB_SCRIPT
  ENVIRONMENT_SETUP
  RUNTIME_CONFIG
  RESOURCE_MANIFEST
  SECRETS
  DEPENDENCY_FILE
  CUSTOM
}

enum storage_type {
  INLINE
  FILE_PATH
  EXTERNAL_URL
}

enum access_type {
  BROWSER
  SLATE_SCRATCH
}

enum NOTIFICATION_STATUS {
  CREATED
  ACKNOWLEDGED
  RESOLVED
}

enum upload_status {
  UPLOADING
  UPLOAD_FAILED
  UPLOADED
  PROCESSING
  PROCESSING_FAILED
  COMPLETE
  FAILED
}

enum upload_type {
  // FILE
  // DIRECTORY
  DATASET
}

enum DATASET_CREATE_METHOD {
  UPLOAD
  IMPORT
  SCAN
}

enum argument_value_type {
  STRING
  NUMBER
  BOOLEAN
}

// CMG Sync Tables - For polling-based synchronization
model cmg_sync_cursor {
  poller_name       String    @id
  last_updated_at   DateTime?
  last_cmg_objectid String?
  locked_by         String?
  lock_expires_at   DateTime?
  last_started_at   DateTime?
  last_succeeded_at DateTime?
  last_failed_at    DateTime?
  last_error        String?
  last_run_count    Int?
  updated_at        DateTime  @updatedAt
}

model cmg_sync_retry {
  id               Int      @id @default(autoincrement())
  poller_name      String
  cmg_id           String
  failure_count    Int      @default(0)
  last_error       String?
  next_retry_at    DateTime?
  updated_at       DateTime @updatedAt

  @@unique([poller_name, cmg_id])
}

model cmg_sync_process_lock {
  process_name      String    @id @db.VarChar(50)
  locked_by         String?   @db.VarChar(200)
  lock_expires_at   DateTime?
  last_started_at   DateTime?
  last_completed_at DateTime?
  updated_at        DateTime  @updatedAt
}
